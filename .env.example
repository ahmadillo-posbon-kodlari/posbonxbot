# GEMINI_API_KEY: Primary Gemini AI API key injected by AI Studio at runtime.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Dedicated Gemini API keys for separate modules (fallback to GEMINI_API_KEY automatically):
GEMINI_CHAT_API_KEY="MY_GEMINI_CHAT_API_KEY"
GEMINI_SCANNER_API_KEY="MY_GEMINI_SCANNER_API_KEY"
GEMINI_ANALYTICS_API_KEY="MY_GEMINI_ANALYTICS_API_KEY"

# TELEGRAM_BOT_TOKEN: Telegram Bot token for @POSBONXBOT
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

